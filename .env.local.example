# Local email/reporting configuration.
# Do not put real secrets in this example file.

# Required for server-side Resend email sending.
RESEND_API_KEY=

# Required unless RESEND_FROM is set. Must be a verified Resend sender.
FROM_EMAIL=

# Optional override for report emails. Defaults to support@mylearna.com.
SUPPORT_EMAIL=support@mylearna.com

# Optional sender override for report emails. Falls back to FROM_EMAIL.
RESEND_FROM=

# Optional Sentry error monitoring configuration.
# Set NEXT_PUBLIC_ENABLE_SENTRY_EXAMPLE=true locally to enable /sentry-example-page.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_ENABLE_SENTRY_EXAMPLE=false
# MyLearna Marketplace. Keep the private token server-only and never commit real values.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Server-only Calendar integrations
SUPABASE_SERVICE_ROLE_KEY=
CALENDAR_INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CRON_SECRET=
