# Local email/reporting configuration.
# Do not put real secrets in this example file.

# Required for server-side Resend email sending.
RESEND_API_KEY=

# Required unless RESEND_FROM is set. Must be a verified Resend sender.
FROM_EMAIL=

# Optional override for report emails. Defaults to support@mylearna.com.
SUPPORT_EMAIL=support@mylearna.com

# Optional sender override for report emails. Falls back to FROM_EMAIL.
RESEND_FROM=

# Optional Sentry error monitoring configuration.
# Set NEXT_PUBLIC_ENABLE_SENTRY_EXAMPLE=true locally to enable /sentry-example-page.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_ENABLE_SENTRY_EXAMPLE=false

# Intelligence Engine feature flags. Keep disabled until the isolated migrations are applied and verified.
NEXT_PUBLIC_ENABLE_INTELLIGENCE_ENGINE=false
NEXT_PUBLIC_ENABLE_INTELLIGENCE_RECOMMENDATIONS=false
NEXT_PUBLIC_ENABLE_INTELLIGENCE_RECOMMENDATION_DEBUG=false
NEXT_PUBLIC_ENABLE_INTELLIGENCE_SHOPIFY_COMMERCE=false
NEXT_PUBLIC_ENABLE_INTELLIGENCE_LEARNING_BASKET=false
NEXT_PUBLIC_ENABLE_INTELLIGENCE_COMMERCE_MAPPING_ADMIN=false

# Shopify Storefront API. Server-side only; never expose the token through NEXT_PUBLIC_ variables.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=
SHOPIFY_REGION=AU
SHOPIFY_REQUEST_TIMEOUT_MS=8000
SHOPIFY_MAX_PRODUCTS_PER_RESOURCE=12

# MyLearna Marketplace. Keep the private token server-only and never commit real values.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
